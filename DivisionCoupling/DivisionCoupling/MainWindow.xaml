<Window x:Class="DivisionCoupling.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ファイル分割"
        Icon="DivisionCoupling.ico"
        ResizeMode="CanMinimize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        FontFamily="MS UI Gothic"
        FontSize="12"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>
    <!-- MFC版のダイアログ(IDD_DIVISION_DIALOG)を実測した位置・大きさ(96dpiのピクセル)でそのまま並べる。
         Tabの順番もリソースの記述順に合わせている -->
    <Canvas Width="256" Height="221">
        <GroupBox Header="分割" Canvas.Left="12" Canvas.Top="11" Width="229" Height="105" IsTabStop="False" />
        <TextBlock Text="オリジナルファイルを指定" TextAlignment="Center" Canvas.Left="26" Canvas.Top="32" Width="116" Height="12" />
        <TextBox x:Name="textBox_SplitFileName" Canvas.Left="26" Canvas.Top="44" Width="116" Height="21" />
        <Button x:Name="button_SplitBrowse" Content="参照" Canvas.Left="142" Canvas.Top="44" Width="33" Height="21" Click="button_SplitBrowse_Click" />
        <TextBlock Text="分割サイズ（KB）" TextAlignment="Center" Canvas.Left="26" Canvas.Top="69" Width="82" Height="12" />
        <TextBox x:Name="textBox_Size" Canvas.Left="26" Canvas.Top="81" Width="86" Height="21"
                 InputMethod.IsInputMethodEnabled="False"
                 PreviewTextInput="textBox_Size_PreviewTextInput"
                 PreviewKeyDown="textBox_Size_PreviewKeyDown" />
        <Button x:Name="button_Split" Content="分割" Canvas.Left="182" Canvas.Top="23" Width="51" Height="42" Click="button_Split_Click" />
        <GroupBox Header="結合" Canvas.Left="12" Canvas.Top="117" Width="229" Height="62" IsTabStop="False" />
        <TextBlock Text="分割ファイルの一つを指定" TextAlignment="Center" Canvas.Left="26" Canvas.Top="138" Width="124" Height="12" />
        <TextBox x:Name="textBox_MergeFileName" Canvas.Left="26" Canvas.Top="150" Width="116" Height="21" />
        <Button x:Name="button_MergeBrowse" Content="参照" Canvas.Left="142" Canvas.Top="150" Width="33" Height="21" Click="button_MergeBrowse_Click" />
        <Button x:Name="button_Merge" Content="結合" Canvas.Left="182" Canvas.Top="129" Width="51" Height="42" Click="button_Merge_Click" />
        <ProgressBar x:Name="progressBar_SplitMerge" Canvas.Left="12" Canvas.Top="191" Width="130" Height="20" Minimum="0" Maximum="100" IsTabStop="False" />
        <Button x:Name="button_Stop" Content="停止" Canvas.Left="142" Canvas.Top="189" Width="33" Height="21" IsEnabled="False" Click="button_Stop_Click" />
        <Button x:Name="button_Close" Content="閉じる" Canvas.Left="189" Canvas.Top="189" Width="51" Height="21" IsDefault="True" IsCancel="True" Click="button_Close_Click" />
    </Canvas>
</Window>
