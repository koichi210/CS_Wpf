<Window x:Class="CubNotice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="カブ隊 開催案内ツール" Height="640" Width="1000"
        Language="ja-JP" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop" Closing="Window_Closing">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="PDFをドラッグ＆ドロップするか「PDFを開く」で取り込みます。" />
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="MainTab" Margin="6">
            <TabItem Header="予定一覧">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button x:Name="OpenPdfButton" Content="PDFを開く(_O)..." Padding="10,3" Margin="0,0,6,0" Click="OpenPdfButton_Click" />
                        <TextBlock Text="ページ" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="PageNumberBox" Width="36" VerticalContentAlignment="Center" Margin="0,0,12,0" />
                        <Button x:Name="PasteTextButton" Content="クリップボードの文字から取込(_V)" Padding="10,3" Margin="0,0,24,0" Click="PasteTextButton_Click"
                                ToolTip="PDFから文字が取れない時用。PDFビューアでページの文字をコピーしてから押します。" />
                        <Button x:Name="DeleteRowButton" Content="選択行を削除(_D)" Padding="10,3" Margin="0,0,6,0" Click="DeleteRowButton_Click" />
                        <Button x:Name="RemovePastButton" Content="過ぎた予定を削除(_R)" Padding="10,3" Click="RemovePastButton_Click" />
                    </WrapPanel>
                    <DataGrid x:Name="EventGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="True" HeadersVisibility="Column" RowHeight="NaN"
                              VerticalGridLinesBrush="LightGray" HorizontalGridLinesBrush="LightGray"
                              CellEditEnding="EventGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="開催日" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="85" />
                            <DataGridTextColumn Header="曜日" Binding="{Binding DayOfWeekText}" Width="45" />
                            <DataGridTextColumn Header="区分" Binding="{Binding KindText, Mode=OneWay}" Width="60" IsReadOnly="True" />
                            <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="200"
                                                ElementStyle="{StaticResource CellTextStyle}" EditingElementStyle="{StaticResource MultiLineEditStyle}" />
                            <DataGridTextColumn Header="サブタイトル" Binding="{Binding Subtitle}" Width="160"
                                                ElementStyle="{StaticResource CellTextStyle}" EditingElementStyle="{StaticResource MultiLineEditStyle}" />
                            <DataGridTextColumn Header="集合" Binding="{Binding Gathering}" Width="140"
                                                ElementStyle="{StaticResource CellTextStyle}" EditingElementStyle="{StaticResource MultiLineEditStyle}" />
                            <DataGridTextColumn Header="解散" Binding="{Binding Dismissal}" Width="140"
                                                ElementStyle="{StaticResource CellTextStyle}" EditingElementStyle="{StaticResource MultiLineEditStyle}" />
                            <DataGridTextColumn Header="活動場所" Binding="{Binding Place}" Width="100"
                                                ElementStyle="{StaticResource CellTextStyle}" EditingElementStyle="{StaticResource MultiLineEditStyle}" />
                            <DataGridTextColumn Header="もちもの" Binding="{Binding Belongings}" Width="120"
                                                ElementStyle="{StaticResource CellTextStyle}" EditingElementStyle="{StaticResource MultiLineEditStyle}" />
                            <DataGridTextColumn Header="備考" Binding="{Binding Notes}" Width="220"
                                                ElementStyle="{StaticResource CellTextStyle}" EditingElementStyle="{StaticResource MultiLineEditStyle}" />
                            <DataGridTextColumn Header="固定ヘッダ" Binding="{Binding Header}" Width="160"
                                                ElementStyle="{StaticResource CellTextStyle}" EditingElementStyle="{StaticResource MultiLineEditStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="次回開催案内">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <RadioButton x:Name="NextRadio" Content="次回" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Checked="TargetRadio_Checked" />
                        <RadioButton x:Name="AfterNextRadio" Content="次の次" VerticalAlignment="Center" Margin="0,0,10,0" Checked="TargetRadio_Checked" />
                        <Button x:Name="MakeNextButton" Content="開催案内をだす(_N)" Padding="10,3" Margin="0,0,6,0" Click="MakeNextButton_Click" />
                        <Button x:Name="CopyButton" Content="コピー(_C)" Padding="10,3" Margin="0,0,12,0" Click="CopyButton_Click" />
                        <TextBlock x:Name="NextInfoText" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBox x:Name="AnnouncementBox" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontSize="14" />
                </DockPanel>
            </TabItem>

            <TabItem Header="設定">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="固定ヘッダ(取り込み時に各予定へ設定されます)" Margin="0,0,0,4" />
                    <TextBox x:Name="HeaderBox" Grid.Row="1" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,6,0" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="6,0,0,4" TextWrapping="Wrap"
                               Text="案内文テンプレート(差し込み項目がすべて空の行は、行ごと消えます)" />
                    <TextBox x:Name="TemplateBox" Grid.Row="1" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="6,0,0,0" />
                    <TextBlock x:Name="PlaceholderHelp" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <DockPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0" LastChildFill="False">
                        <Button x:Name="SaveSettingsButton" Content="設定を保存(_S)" Padding="10,3" Margin="0,0,6,0" Click="SaveSettingsButton_Click" />
                        <Button x:Name="ResetTemplateButton" Content="テンプレートを既定に戻す" Padding="10,3" Margin="0,0,6,0" Click="ResetTemplateButton_Click" />
                        <Button x:Name="ApplyHeaderButton" Content="固定ヘッダを全予定に反映" Padding="10,3" Margin="0,0,6,0" Click="ApplyHeaderButton_Click" />
                        <Button x:Name="OpenDataFolderButton" Content="データフォルダを開く" Padding="10,3" DockPanel.Dock="Right" Click="OpenDataFolderButton_Click" />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
