<Window x:Class="FFEdit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stc="clr-namespace:StandardTemplate.Wpf"
        Title="FFEdit" Icon="FFEdit.ico"
        Width="506" Height="536" MinWidth="506" MinHeight="536"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12,5,12,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 1段目: 対象フォルダ(左右に伸びる) -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="対象フォルダ" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0" />
            <stc:ComboBoxEx Grid.Column="1" x:Name="comboBox_TargetDir" VerticalAlignment="Center"
                            PreviewKeyDown="comboBox_TargetDir_PreviewKeyDown" />
            <Button Grid.Column="2" x:Name="button_Listup" Content="リストアップ" Width="75" Height="23" Margin="8,0,0,0"
                    Click="button_Listup_Click" />
        </Grid>

        <!-- 2段目左: 対象の条件と、処理ごとのタブ(上下に伸びる) -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="対象" Padding="4,2,4,4">
                <StackPanel>
                    <RadioButton x:Name="radioButton_Target_Dir" GroupName="Target" Content="フォルダ" Margin="6,2,0,2"
                                 Checked="UpdateListBox" />
                    <RadioButton x:Name="radioButton_Target_File" GroupName="Target" Content="ファイル" Margin="6,2,0,2"
                                 IsChecked="True" Checked="UpdateListBox" />
                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="77" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="フィルター" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,3,0" />
                        <stc:TextBoxEx Grid.Column="1" x:Name="textBox_Target_Extension" VerticalAlignment="Center"
                                       KeyUp="textBox_Target_Extension_KeyUp" />
                    </Grid>
                    <CheckBox x:Name="checkBox_Target_SubDirectory" Content="サブフォルダも表示" Margin="6,4,0,2"
                              Checked="UpdateListBox" Unchecked="UpdateListBox" />
                    <CheckBox x:Name="checkBox_Target_SelectFile" Content="選択項目のみ" Margin="6,2,0,2" />
                </StackPanel>
            </GroupBox>

            <TabControl Grid.Row="1" x:Name="tabControl" Margin="0,8,0,0">
                <TabItem x:Name="tabPage_ChangeName" Header="名称変換">
                    <StackPanel Margin="6,6,6,4">
                        <RadioButton x:Name="radioButton_ChangeNumber" GroupName="ChangeName" Content="通し番号"
                                     IsChecked="True" Checked="UpdateNameChangeControl" />
                        <StackPanel Orientation="Horizontal" Margin="17,4,0,0">
                            <Label x:Name="label_ChangeNumber_FirstVal" Content="最初の値" Padding="0" VerticalAlignment="Center" Margin="0,0,3,0" />
                            <stc:TextBoxEx x:Name="textBox_ChangeNumber_FirstVal" Text="1" Width="68" TextAlignment="Right"
                                           VerticalAlignment="Center" />
                            <ComboBox x:Name="comboBox_ChangeNumber_Digit" Width="74" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox x:Name="checkBox_ChangeNumber_OrgName" Content="もとのファイル名を残す" Margin="19,5,0,0" />
                        <RadioButton x:Name="radioButton_ChangeAddDirName" GroupName="ChangeName" Content="フォルダ名をファイル名に追加"
                                     Margin="0,9,0,0" Checked="UpdateNameChangeControl" />
                        <RadioButton x:Name="radioButton_ChangeDelNum" GroupName="ChangeName" Content="指定文字数だけ削除"
                                     Margin="0,4,0,0" Checked="UpdateNameChangeControl" />
                        <RadioButton x:Name="radioButton_ChangeExt" GroupName="ChangeName" Content="拡張子変更"
                                     Margin="0,4,0,0" Checked="UpdateNameChangeControl" />
                        <RadioButton x:Name="radioButton_ChangeDelete" GroupName="ChangeName" Content="指定文字の削除"
                                     Margin="0,4,0,0" Checked="UpdateNameChangeControl" />
                        <RadioButton x:Name="radioButton_ChangeAdd" GroupName="ChangeName" Content="文字の追加"
                                     Margin="0,4,0,0" Checked="UpdateNameChangeControl" />
                        <RadioButton x:Name="radioButton_ChangeReplace" GroupName="ChangeName" Content="文字の置換"
                                     Margin="0,4,0,0" Checked="UpdateNameChangeControl" />
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- WinForms版と同じく、起動直後は「先頭から/後方から」の表示で入力欄は無効 -->
                            <Label Grid.Row="0" Grid.Column="0" x:Name="label_String1" Content="先頭から" Padding="0"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" />
                            <stc:ComboBoxEx Grid.Row="0" Grid.Column="1" x:Name="comboBox_String1" IsEnabled="False" />
                            <Label Grid.Row="1" Grid.Column="0" x:Name="label_String2" Content="後方から" Padding="0"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" />
                            <stc:ComboBoxEx Grid.Row="1" Grid.Column="1" x:Name="comboBox_String2" IsEnabled="False" Margin="0,3,0,0" />
                        </Grid>
                    </StackPanel>
                </TabItem>

                <TabItem x:Name="tabPage_TimeStamp" Header="タイムスタンプ">
                    <StackPanel Margin="6,6,6,4">
                        <Label Content="基準日" Padding="0" />
                        <DatePicker x:Name="dateTimePicker_Days" Margin="3,4,0,0"
                                    DisplayDateStart="1980-01-01" DisplayDateEnd="3000-12-31" />
                        <Grid Margin="3,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="textBox_Time" VerticalContentAlignment="Center"
                                     PreviewKeyDown="textBox_Time_PreviewKeyDown" LostKeyboardFocus="textBox_Time_LostKeyboardFocus" />
                            <StackPanel Grid.Column="1" Width="17">
                                <RepeatButton x:Name="button_TimeUp" Height="11" Padding="0" FontSize="6" Content="▲"
                                              Focusable="False" Click="button_TimeUp_Click" />
                                <RepeatButton x:Name="button_TimeDown" Height="11" Padding="0" FontSize="6" Content="▼"
                                              Focusable="False" Click="button_TimeDown_Click" />
                            </StackPanel>
                        </Grid>
                        <Label Content="加算間隔" Padding="0" Margin="0,16,0,0" />
                        <ComboBox x:Name="comboBox_TimeSpan" Margin="3,3,0,0" />
                        <GroupBox Header="更新対象" Margin="2,18,0,0" Padding="4,2,4,4">
                            <StackPanel Margin="14,2,0,0">
                                <CheckBox x:Name="checkBox_CreationTime" Content="作成日時" IsChecked="True" Margin="0,2,0,3" />
                                <CheckBox x:Name="checkBox_LastWriteTime" Content="更新日時" IsChecked="True" Margin="0,3,0,3" />
                                <CheckBox x:Name="checkBox_LastAccessTime" Content="アクセス日時" IsChecked="True" Margin="0,3,0,2" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </TabItem>

                <TabItem x:Name="tabPage_Function" Header="機能">
                    <StackPanel Margin="6,6,6,4">
                        <RadioButton x:Name="radioButton_Delete_BlankDir" GroupName="Function" Content="空のフォルダを削除"
                                     IsChecked="True" Checked="UpdateFunctionControl" />
                        <RadioButton x:Name="radioButton_Move_Target" GroupName="Function" Content="移動"
                                     Margin="0,5,0,0" Checked="UpdateFunctionControl" />
                        <RadioButton x:Name="radioButton_Copy_Target" GroupName="Function" Content="コピー"
                                     Margin="0,5,0,0" Checked="UpdateFunctionControl" />
                        <CheckBox x:Name="checkBox_Operation_AnyDir" Content="フォルダを指定する" IsEnabled="False"
                                  Margin="16,5,0,0" Checked="UpdateFunctionControl" Unchecked="UpdateFunctionControl" />
                        <stc:TextBoxEx x:Name="textBox_Function_Any_Directory" IsEnabled="False" Margin="31,4,0,0"
                                       GotKeyboardFocus="textBox_Function_Any_Directory_GotKeyboardFocus"
                                       PreviewMouseLeftButtonUp="textBox_Function_Any_Directory_PreviewMouseLeftButtonUp" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 2段目右: 一覧(上下左右に伸びる) -->
        <ListBox Grid.Row="1" Grid.Column="1" x:Name="listBox" Margin="4,6,0,0" SelectionMode="Extended"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 SelectionChanged="listBox_SelectionChanged" PreviewKeyDown="listBox_PreviewKeyDown" />

        <!-- 3段目: 左下にステータス、右下にボタン -->
        <stc:TextBoxEx Grid.Row="2" Grid.Column="0" x:Name="textBox_StatusBar" IsReadOnly="True" TextAlignment="Right"
                       Width="236" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,8,0,0" />
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="button_SaveSetting" Content="設定保存" Width="84" Height="23" Click="button_SaveSetting_Click" />
            <Button x:Name="button_Restore" Content="復元" Width="65" Height="23" Margin="5,0,0,0" Click="button_Restore_Click" />
            <Button x:Name="button_Execute" Content="実行" Width="65" Height="23" Margin="4,0,0,0" Click="button_Execute_Click" />
        </StackPanel>
    </Grid>
</Window>
