<Window x:Class="TrimHtmlData.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stc="clr-namespace:StandardTemplate.Wpf"
        Title="TrimHtmlData" Icon="TrimHtmlData.ico"
        Width="730" Height="420" MinWidth="686" MinHeight="405">
    <!-- 背景(コントロールの無い所)のダブルクリックでデバッグモードを切り替える(WinForms版のForm1_DoubleClick)。
         Backgroundを付けておかないと余白部分がクリックを受け取らない -->
    <Border x:Name="layoutRoot" Background="Transparent" Padding="12" MouseLeftButtonDown="layoutRoot_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="306" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 取得元 / 取得値 -->
            <Label Grid.Row="0" Grid.Column="0" Content="取得元" Padding="0,0,0,2" />
            <stc:TextBoxEx Grid.Row="1" Grid.Column="0" x:Name="textBox_SourceList"
                           AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                           ToolTip="HTMLを取得するページのURL。1行に1つずつ書く(空行は無視)"
                           ToolTipService.ShowDuration="15000" />
            <Label Grid.Row="0" Grid.Column="1" Content="取得値" Padding="0,0,0,2" Margin="33,0,0,0" />
            <stc:TextBoxEx Grid.Row="1" Grid.Column="1" x:Name="textBox_DestList" Margin="33,0,0,0"
                           AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

            <!-- 検索文字(終端はWinForms版でも非表示・処理にも未使用。設定ファイルの互換のため残してある) -->
            <Grid Grid.Row="2" Grid.Column="0" Margin="0,6,0,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="検索文字先頭：" Padding="0,0,6,0" VerticalAlignment="Center" />
                <stc:TextBoxEx Grid.Row="0" Grid.Column="1" x:Name="textBox_SearchWord" VerticalAlignment="Center"
                               stc:Placeholder.Text="例: &lt;title&gt;"
                               ToolTip="この文字列を含む行を探す。行内のどこにあってもヒットする"
                               ToolTipService.ShowDuration="15000" />
                <Label Grid.Row="1" Grid.Column="0" x:Name="label_DelimiterWord" Content="検索文字終端：" Padding="0,0,6,0" VerticalAlignment="Center"
                       Visibility="Collapsed" />
                <stc:TextBoxEx Grid.Row="1" Grid.Column="1" x:Name="textBox_DelimiterWord" VerticalAlignment="Center" Margin="0,6,0,0"
                               Visibility="Collapsed" />
            </Grid>

            <!-- 取得行数・オプション・実行 -->
            <Grid Grid.Row="2" Grid.Column="1" Margin="33,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="98" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="取得行数：" Padding="0,0,6,0" VerticalAlignment="Center" />
                <stc:TextBoxEx Grid.Row="0" Grid.Column="1" x:Name="textBox_TrimLineNum" VerticalAlignment="Center"
                               stc:Placeholder.Text="例: 1"
                               ToolTip="ヒットした行から数えて取り出す行数(ヒット行を含む)。空欄・0は1行として扱う"
                               ToolTipService.ShowDuration="15000" />
                <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" x:Name="checkBox_FirstWordOnly" Content="最初にヒットしたワードだけを抽出" Margin="0,6,0,0"
                          ToolTip="各URLで最初にヒットした箇所だけを取り出す"
                          ToolTipService.ShowDuration="15000" />
                <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" x:Name="checkBox_OrdinalCase" Content="大文字小文字を区別する" Margin="0,4,0,0" />
                <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" x:Name="button_Execute" Content="実行" Width="75" Height="45" VerticalAlignment="Top"
                        ToolTip="各URLのHTMLを取得して該当行を取り出し、結果をクリップボードにもコピーする"
                        ToolTipService.ShowDuration="15000"
                        Click="button_Execute_Click" />
            </Grid>

            <!-- 設定の読み込み/保存 -->
            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" x:Name="comboBox_LoadSetting" Margin="0,0,6,0" VerticalAlignment="Center"
                          ToolTip="選ぶと保存済みの設定を読み込み、各欄の内容が置き換わる"
                          ToolTipService.ShowDuration="15000"
                          SelectionChanged="comboBox_LoadSetting_SelectionChanged" />
                <Button Grid.Column="1" x:Name="button_SaveSetting" Content="設定保存" Width="75" Height="23" Click="button_SaveSetting_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
