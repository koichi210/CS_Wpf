<Window x:Class="ColorConvert.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stw="clr-namespace:StandardTemplate.Wpf"
        xmlns:local="clr-namespace:ColorConvert"
        Title="ColorConvert" Height="223" Width="353">

    <Window.Resources>
        <!--Marginは、左・上・右・下 の順-->
        <Style TargetType="StackPanel" x:Key="StackPanelHorizontalTemplate">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="24,5,0,0"/>
            <Setter Property="Width" Value="300"/>
        </Style>

        <Style TargetType="Label" x:Key="LabelTemplate">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Width" Value="80"/>
        </Style>

        <Style TargetType="TextBox" x:Key="TextBoxTemplate">
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <Style TargetType="Slider" x:Key="SliderTemplate">
            <Setter Property="Margin" Value="10, 0, 0, 0" />
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Maximum" Value="255"/>
            <Setter Property="SmallChange" Value="1"/>
            <Setter Property="LargeChange" Value="5"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickPlacement" Value="TopLeft"/>
            <Setter Property="TickFrequency" Value="20"/>
        </Style>

        <!--RgbToColorConverter はColorConvertのpublicクラス-->
        <local:RgbToColorConverter x:Key="RgbToColorConverter" />
    </Window.Resources>

    <Grid RenderTransformOrigin="0,0" Margin="0,0,18,8">
        <StackPanel Orientation="Vertical" Margin="0,0,-16,-8">
            <StackPanel Style="{StaticResource StackPanelHorizontalTemplate}">
                <Label x:Name="ColorNameRed" Content="Color Red:"  Style="{StaticResource LabelTemplate}"/>
                <TextBox Name="ColorValueRed" ToolTip="0〜255の値。入力後にフォーカスを外すとスライダーと下の色見本に反映される" stw:Placeholder.Text="例: 128" Style="{StaticResource TextBoxTemplate}"
                         Text="{Binding ElementName=ColorSliderRed, Path=Value}"/>
                <Slider Name="ColorSliderRed" ToolTip="0〜255で調整する。ドラッグや矢印キーでは目盛り(20刻み)と255の位置にだけ止まるので、中間の値は左の欄に直接入力する" Style="{StaticResource SliderTemplate}" />
            </StackPanel>

            <StackPanel Style="{StaticResource StackPanelHorizontalTemplate}">
                <Label x:Name="ColorNameGreen" Content="Color Green:"  Style="{StaticResource LabelTemplate}"/>
                <TextBox Name="ColorValueGreen" ToolTip="0〜255の値。入力後にフォーカスを外すとスライダーと下の色見本に反映される" stw:Placeholder.Text="例: 128" Style="{StaticResource TextBoxTemplate}"
                         Text="{Binding ElementName=ColorSliderGreen, Path=Value}"/>
                <Slider Name="ColorSliderGreen" ToolTip="0〜255で調整する。ドラッグや矢印キーでは目盛り(20刻み)と255の位置にだけ止まるので、中間の値は左の欄に直接入力する" Style="{StaticResource SliderTemplate}" />
            </StackPanel>

            <StackPanel Style="{StaticResource StackPanelHorizontalTemplate}">
                <Label x:Name="ColorNameBlue" Content="Color Blue:"  Style="{StaticResource LabelTemplate}"/>
                <TextBox Name="ColorValueBlue" ToolTip="0〜255の値。入力後にフォーカスを外すとスライダーと下の色見本に反映される" stw:Placeholder.Text="例: 128" Style="{StaticResource TextBoxTemplate}"
                         Text="{Binding ElementName=ColorSliderBlue, Path=Value}"/>
                <Slider Name="ColorSliderBlue" ToolTip="0〜255で調整する。ドラッグや矢印キーでは目盛り(20刻み)と255の位置にだけ止まるので、中間の値は左の欄に直接入力する" Style="{StaticResource SliderTemplate}" />
            </StackPanel>

            <StackPanel Style="{StaticResource StackPanelHorizontalTemplate}" Margin="30,20,0,0">
                <Rectangle Width="285" Height="60" HorizontalAlignment="Center" Stroke="Black">
                    <Rectangle.Fill>
                        <SolidColorBrush>
                            <SolidColorBrush.Color>
                                <MultiBinding Converter="{StaticResource RgbToColorConverter}">
                                    <MultiBinding.Bindings>
                                        <Binding ElementName="ColorSliderRed" Path="Value" />
                                        <Binding ElementName="ColorSliderGreen" Path="Value" />
                                        <Binding ElementName="ColorSliderBlue" Path="Value" />
                                    </MultiBinding.Bindings>
                                </MultiBinding>
                            </SolidColorBrush.Color>
                        </SolidColorBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
