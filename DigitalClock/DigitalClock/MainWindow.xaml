<Window x:Class="DigitalClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clock"
        Icon="DigitalClock.ico"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Left="100" Top="100"
        Topmost="True"
        Background="{DynamicResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing">
    <TextBlock x:Name="label_time"
               Text="00:00:00"
               FontFamily="MS UI Gothic"
               FontSize="16"
               ToolTip="時刻の部分を左ドラッグするとウィンドウを移動できる"
               ToolTipService.ShowDuration="15000"
               MouseLeftButtonDown="label_time_MouseLeftButtonDown" />
</Window>
