<Window x:Class="MotionCapture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MotionCapture"
        Icon="MotionCapture.ico"
        ResizeMode="CanMinimize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        FontFamily="MS UI Gothic"
        FontSize="12"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>
    <!-- MFC版のダイアログ(IDD_MOTIONCAPTURE_DIALOG)を実測した位置・大きさ(96dpiのピクセル)でそのまま並べる。
         Tabの順番もリソースの記述順に合わせている -->
    <Canvas Width="390" Height="218">
        <TextBlock Text="保存ファイル名：" Canvas.Left="26" Canvas.Top="14" />
        <TextBox x:Name="textBox_SaveFileName" Canvas.Left="149" Canvas.Top="11" Width="229" Height="21" />

        <GroupBox Header="キャプチャ設定" Canvas.Left="19" Canvas.Top="39" Width="212" Height="137" />
        <TextBlock Text="X：" Canvas.Left="63" Canvas.Top="60" />
        <TextBox x:Name="textBox_CaptRectX" Canvas.Left="79" Canvas.Top="57" Width="44" Height="21" />
        <TextBlock Text="Width：" Canvas.Left="44" Canvas.Top="83" />
        <TextBox x:Name="textBox_CaptRectWidth" Canvas.Left="79" Canvas.Top="80" Width="44" Height="21" />
        <TextBlock Text="Y：" Canvas.Left="159" Canvas.Top="60" />
        <TextBox x:Name="textBox_CaptRectY" Canvas.Left="175" Canvas.Top="57" Width="44" Height="21" />
        <TextBlock Text="Height：" Canvas.Left="135" Canvas.Top="83" />
        <TextBox x:Name="textBox_CaptRectHeight" Canvas.Left="175" Canvas.Top="80" Width="44" Height="21" />

        <GroupBox Header="動画設定" Canvas.Left="238" Canvas.Top="39" Width="140" Height="137" />
        <TextBlock Text="bpp：" Canvas.Left="289" Canvas.Top="60" />
        <TextBox x:Name="textBox_CaptBpp" Canvas.Left="317" Canvas.Top="57" Width="44" Height="21" />
        <TextBlock Text="FPS：" Canvas.Left="287" Canvas.Top="83" />
        <TextBox x:Name="textBox_CaptFps" Canvas.Left="317" Canvas.Top="80" Width="44" Height="21" />
        <TextBlock Text="コマ送り：" Canvas.Left="270" Canvas.Top="105" />
        <TextBox x:Name="textBox_SkipFrame" Canvas.Left="317" Canvas.Top="102" Width="44" Height="21" />
        <TextBlock Text="TimeoutSec：" Canvas.Left="247" Canvas.Top="128" />
        <TextBox x:Name="textBox_TimeoutSec" Canvas.Left="317" Canvas.Top="125" Width="44" Height="21" />

        <CheckBox x:Name="checkBox_Resize" Content="リサイズ有効" Canvas.Left="26" Canvas.Top="131" Width="88" Height="15" />
        <TextBlock Text="Width：" Canvas.Left="44" Canvas.Top="152" />
        <TextBox x:Name="textBox_ResizeRectWidth" Canvas.Left="79" Canvas.Top="149" Width="44" Height="21" />
        <TextBlock Text="Height：" Canvas.Left="135" Canvas.Top="152" />
        <TextBox x:Name="textBox_ResizeRectHeight" Canvas.Left="175" Canvas.Top="149" Width="44" Height="21" />

        <Button x:Name="button_CaptAreaSample" Content="記録領域の確認" Canvas.Left="19" Canvas.Top="186" Width="210" Height="21" Click="button_CaptAreaSample_Click" />
        <Button x:Name="button_Record" Content="記録開始" Canvas.Left="240" Canvas.Top="186" Width="68" Height="21" Click="button_Record_Click" />
        <Button x:Name="button_RecordStop" Content="記録停止" Canvas.Left="310" Canvas.Top="186" Width="68" Height="21" Click="button_RecordStop_Click" />
        <CheckBox x:Name="checkBox_MousePointRec" Content="マウスポインタを記録" Canvas.Left="247" Canvas.Top="153" Width="124" Height="15" />
    </Canvas>
</Window>
