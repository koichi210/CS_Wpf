<Window x:Class="TurnMemory.AnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解答"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        FontFamily="MS PGothic"
        FontSize="12"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        SourceInitialized="Window_SourceInitialized">
    <!-- MFC版の解答ダイアログ(211×193 DLU)を1DLU=1.5pxで再現。マスと見出しはCellGridがコードで並べる -->
    <Canvas x:Name="canvas" Width="316.5" Height="289.5">
        <Button x:Name="buttonOk" Content="閉じれ" IsDefault="True" IsCancel="True"
                Canvas.Left="222" Canvas.Top="258" Width="75" Height="21"
                Click="buttonOk_Click" />
        <TextBlock x:Name="textTitle" Text="Title Text" TextAlignment="Center"
                   Canvas.Left="88.5" Canvas.Top="21" Width="129" Height="12" />
    </Canvas>
</Window>
