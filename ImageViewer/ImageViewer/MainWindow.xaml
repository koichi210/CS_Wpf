<Window x:Class="ImageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ImageViewer"
        Title="ImageViewer" Height="600" Width="960"
        Loaded="WindowLoaded">

    <Window.Resources>
        <Style TargetType="StackPanel" x:Key="StackPanelInGroupBoxTemplate">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Height" Value="80"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="30"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,-5,0,0"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="TextBlockTemplate">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="MinHeight" Value="80"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <!--Converterメソッド-->
        <local:ThumbnailSizeNameConverter x:Key="ThumbnailSizeNameConverter"/>
        <local:ThumbnailSizeWidthConverter x:Key="ThumbnailSizeWidthConverter"/>
        <local:ThumbnailSizeHeightConverter x:Key="ThumbnailSizeHeightConverter"/>
    </Window.Resources>

    <DockPanel>
        <!--Imageコントロールの画像が上に張り付く
        <StackPanel Orientation="Vertical">-->
        <!--上の操作欄。StackPanel(横並び)だと子のDockPanel.Dockが効かず、「ファイル」欄がウィンドウ右端に
        吸着しなかったので、DockPanelにして左の欄を順に詰め、最後の「ファイル」欄で残りの幅を右端まで埋める-->
        <DockPanel DockPanel.Dock="Top" LastChildFill="True">
            <!--以前は「開く」ボタンが2つ(エクスプローラー形式/ツリー形式)並んでいて見分けがつかなかったので、
            ボタンは1つにして、どちらのダイアログで開くかをラジオボタンで選ぶ-->
            <GroupBox Header="開く" Width="130" DockPanel.Dock="Left">
                <StackPanel Orientation="Vertical" Margin="2,2,0,0">
                    <RadioButton Name="RadioOpenExplorer" Content="エクスプローラー形式" IsChecked="True" GroupName="OpenStyle"
                                 ToolTip="エクスプローラーと同じ形のダイアログでフォルダを選ぶ(上のアドレス欄にパスを貼り付けられる)"/>
                    <RadioButton Name="RadioOpenTree" Content="ツリー形式" GroupName="OpenStyle" Margin="0,2,0,0"
                                 ToolTip="フォルダの木構造を掘っていくダイアログでフォルダを選ぶ"/>
                    <Button Name="ButtonOpenDialog" Content="開く" Width="60" Margin="0,4,0,0" HorizontalAlignment="Left"
                            ToolTip="上で選んだ形のダイアログでフォルダを選び、直下の画像(.jpg .bmp .png .tiff .gif)と動画(.mp4 .mov .avi .wmv など)をサムネイル表示する"
                            Click="ButtonOpenDialog_Click"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="サムネイルのサイズ" DockPanel.Dock="Left" >
                <StackPanel Style="{StaticResource StackPanelInGroupBoxTemplate}" >
                    <TextBlock Text="{Binding ElementName=SliderThumbnail, Path=Value, Converter={StaticResource ThumbnailSizeNameConverter}}"/>
                    <Slider Name="SliderThumbnail" ToolTip="サムネイルの大きさを3段階で切り替える(Small 40×30 / Middle 80×60 / Large 120×90)"
                        Minimum="1" Maximum="3" TickFrequency="1" SmallChange="1" LargeChange="1" Value="2"
                        TickPlacement="BottomRight"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="拡大/縮小" DockPanel.Dock="Left" >
                <StackPanel Style="{StaticResource StackPanelInGroupBoxTemplate}" >
                    <TextBlock Text="{Binding ElementName=SliderScale, Path=Value, StringFormat={}{0:0.0} 倍:}" Style="{StaticResource TextBlockTemplate}" />
                    <Slider Name="SliderScale" ToolTip="下に表示中の画像の倍率。0.1〜5.0倍を0.1刻みで指定する。画像の上でマウスホイールを回しても、マウスの位置を中心に拡大/縮小できる"
                        Minimum="0.1" Maximum="5.0" TickFrequency="0.1" SmallChange="0.1" LargeChange="1.0" Value="1.0"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="回転" DockPanel.Dock="Left" >
                <StackPanel Style="{StaticResource StackPanelInGroupBoxTemplate}" >
                    <!--Labelだと、StringFormatでうまく文字が表示できない
                    <Label Content="{Binding ElementName=SliderAngle, Path=Value, StringFormat={0:0000}}" />-->
                    <TextBlock Text="{Binding ElementName=SliderAngle, Path=Value, StringFormat={}{0:000} 度:}" Style="{StaticResource TextBlockTemplate}" />
                    <Slider Name="SliderAngle" ToolTip="下に表示中の画像の回転角。0〜360度を1度刻みで時計回りに回す"
                        Minimum="0" Maximum="360" TickFrequency="1" SmallChange="1" LargeChange="90" Value="0"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="ガンマ補正" DockPanel.Dock="Left" Width="150">
                <StackPanel Style="{StaticResource StackPanelInGroupBoxTemplate}" >
                    <TextBlock Text="{Binding ElementName=SliderGamma, Path=Value, StringFormat={}{0:0.0}:}" Style="{StaticResource TextBlockTemplate}" />
                    <Slider Name="SliderGamma" Width="70"
                        ToolTip="下に表示中の画像の明るさ(ガンマ)。1.0がそのまま、大きくすると中間の暗い所が明るく、小さくすると暗くなる(0.2〜3.0)。ダブルクリックで1.0に戻す"
                        Minimum="0.2" Maximum="3.0" TickFrequency="0.1" SmallChange="0.1" LargeChange="0.5" Value="1.0"
                        ValueChanged="SliderGamma_ValueChanged" MouseDoubleClick="SliderGamma_MouseDoubleClick"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="並び順" DockPanel.Dock="Left" Width="110">
                <StackPanel Orientation="Vertical" Margin="2,4,0,0">
                    <ComboBox Name="ComboSortOrder" Width="96" HorizontalAlignment="Left" SelectedIndex="0"
                              ToolTip="サムネイルの並び順(名前順はエクスプローラーと同じく数字を数として比べる)"
                              SelectionChanged="SortOrder_Changed"/>
                    <CheckBox Name="CheckSortDescending" Content="降順" Margin="0,4,0,0"
                              ToolTip="オンなら逆順(Z→A、大きい順、新しい順)に並べる"
                              Checked="SortOrder_Changed" Unchecked="SortOrder_Changed"/>
                </StackPanel>
            </GroupBox>

            <!--最後の子なので残りの幅いっぱいに広がり、右端がウィンドウ右端に追従する(Width="Auto"でStyleの幅120を打ち消す)-->
            <GroupBox Header="ファイル" Width="Auto" MinWidth="200" DockPanel.Dock="Right">
                <StackPanel Orientation="Vertical" Style="{StaticResource StackPanelInGroupBoxTemplate}" >
                    <!--テキストボックスの値を変更されるとサムネイルが不正動作するのでReadOnlyにする-->
                    <TextBox Name="TextDirName" ToolTip="サムネイル表示中のフォルダ(読み取り専用)。左の「開く」で変更する" IsReadOnly="True"/>
                    <TextBox Name="TextFileName" ToolTip="サムネイル一覧で選択中のファイル名(読み取り専用)" Text="{Binding ElementName=ListBoxThumbnail, Path=SelectedItem.FileName}" IsReadOnly="True"/>
                </StackPanel>
            </GroupBox>
        </DockPanel>

        <!--動画のコマの指定と、表示中の画像の保存-->
        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="2,2,2,0">
            <GroupBox Header="動画のコマ" DockPanel.Dock="Left" Width="Auto" Height="Auto">
                <StackPanel Orientation="Horizontal" Margin="2">
                    <TextBox Name="TextVideoPosition" Width="70" Text="0" VerticalAlignment="Center"
                             ToolTip="表示する位置。「秒」なら 12.5 や 1:23.5(分:秒)、「コマ」なら1始まりのコマ番号(1が先頭)。Enterキーで表示"
                             KeyDown="TextVideoPosition_KeyDown"/>
                    <RadioButton Name="RadioVideoSeconds" Content="秒" IsChecked="True" GroupName="VideoUnit" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <RadioButton Name="RadioVideoFrame" Content="コマ" GroupName="VideoUnit" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="fps:" Margin="10,0,2,0" VerticalAlignment="Center"/>
                    <TextBox Name="TextVideoFps" Width="45" Text="30" VerticalAlignment="Center"
                             ToolTip="「コマ」で指定したときに時間へ直すための1秒あたりのコマ数(例: 29.97)。PATHにffmpeg.exeがあるときはffmpegがコマ番号どおりに取り出すので使わない"/>
                    <Button Name="ButtonShowFrame" Content="コマを表示" Width="75" Margin="8,0,0,0"
                            ToolTip="一覧で選んでいる動画の、指定した位置のコマを下に表示する"
                            Click="ButtonShowFrame_Click"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="保存" DockPanel.Dock="Left" Width="Auto" Height="Auto">
                <Button Name="ButtonSavePng" Content="PNGで保存" Width="80" Margin="2"
                        ToolTip="下に表示中の画像(動画のコマ・ガンマ補正の結果を含む。拡大/縮小・回転は含まない)をPNGファイルに保存する"
                        Click="ButtonSavePng_Click"/>
            </GroupBox>
            <TextBlock Name="TextStatus" VerticalAlignment="Center" Margin="8,6,0,0" TextWrapping="Wrap"/>
        </DockPanel>

        <!--読み込みの進み具合(サムネイルを作り終えた数/全体の数)-->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <ProgressBar Name="ProgressLoad" Width="200" Height="14" Minimum="0" Maximum="1" Value="0"
                             ToolTip="サムネイルの読み込みの進み具合"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Name="TextProgress"/>
            </StatusBarItem>
        </StatusBar>

        <ListBox x:Name="ListBoxThumbnail" DockPanel.Dock="Top" ItemsSource="{Binding}" SelectionChanged="ListBoxThumbnail_SelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <!--サムネイルを横に並べる-->
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>

                    <!--Memo：WrapPanelのOrientationがVerticalの場合、StackPanelのOrientationをHorizontalにしないと、ファイル名が表示されない-->
                    <!--サムネイル画像は読み込み用のスレッドが順に作ってThumbnailImageへ入れる(作り終わるまでは空欄)-->
                    <StackPanel>
                        <Image Stretch="Fill"
                               Source="{Binding ThumbnailImage}"
                               Width="{Binding ElementName=SliderThumbnail, Path=Value, Converter={StaticResource ThumbnailSizeWidthConverter}}"
                               Height="{Binding ElementName=SliderThumbnail, Path=Value, Converter={StaticResource ThumbnailSizeHeightConverter}}"/>
                        <TextBlock Text="{Binding FileName}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--<StackPanel Orientation="Vertical">を設定していると、スクロールバーが常にDisableになる-->
        <!--画像の上でホイールを回すと、縦スクロールの代わりにマウス位置を中心に拡大/縮小する(PreviewMouseWheelで先取りする)-->
        <ScrollViewer Name="ScrollViewerImage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      PreviewMouseWheel="ScrollViewerImage_PreviewMouseWheel">
            <!--「Stretch="None"」にしないとScalingが効かない。
            表示する画像は選択に応じてコードから入れる(画像ファイル、または動画の指定位置のコマに、ガンマ補正を掛けたもの)-->
            <Image Name="ImageView" Stretch="None">
                <Image.LayoutTransform>
                    <TransformGroup>
                        <RotateTransform Angle="{Binding ElementName=SliderAngle, Path=Value}"/>
                        <ScaleTransform ScaleX="{Binding ElementName=SliderScale, Path=Value}" ScaleY="{Binding ElementName=SliderScale, Path=Value}"/>
                    </TransformGroup>
                </Image.LayoutTransform>
            </Image>
        </ScrollViewer>
    </DockPanel>
</Window>
