<Window x:Class="ImageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ImageViewer"
        Title="ImageViewer" Height="520" Width="880"
        Loaded="WindowLoaded"
        Closing="WindowClosing">

    <Window.Resources>
        <Style TargetType="StackPanel" x:Key="StackPanelInGroupBoxTemplate">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Height" Value="80"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="30"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,-5,0,0"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="TextBlockTemplate">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="MinHeight" Value="80"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <!--Converterメソッド-->
        <local:ImageConverter x:Key="ImageConverter"/>
        <local:ThumbnailSizeNameConverter x:Key="ThumbnailSizeNameConverter"/>
        <local:ThumbnailSizeWidthConverter x:Key="ThumbnailSizeWidthConverter"/>
        <local:ThumbnailSizeHeightConverter x:Key="ThumbnailSizeHeightConverter"/>
    </Window.Resources>

    <DockPanel>
        <!--Imageコントロールの画像が上に張り付く
        <StackPanel Orientation="Vertical">-->
        <StackPanel Orientation=" Horizontal" DockPanel.Dock="Top" >
            <GroupBox Header="操作" Width="50" DockPanel.Dock="Left">
                <StackPanel Orientation="Vertical" Style="{StaticResource StackPanelInGroupBoxTemplate}" >
                    <Button Name="ButtonOpenDialog" ToolTip="未実装(フォルダ選択処理がコメントアウトされている)。押すと「フォルダが選択されていません」と表示されるだけ" Content="開く" Click="ButtonOpenDialog_Click"/>
                    <Button Name="ButtonFormOpenDialog" ToolTip="ツリー形式のダイアログでフォルダを選び、直下の画像(.jpg .bmp .png .tiff .gif)をサムネイル表示する" Content="開く" Click="ButtonFormOpenDialog_Click"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="サムネイルのサイズ" DockPanel.Dock="Left" >
                <StackPanel Style="{StaticResource StackPanelInGroupBoxTemplate}" >
                    <TextBlock Text="{Binding ElementName=SliderThumbnail, Path=Value, Converter={StaticResource ThumbnailSizeNameConverter}}"/>
                    <Slider Name="SliderThumbnail" ToolTip="サムネイルの大きさを3段階で切り替える(Small 40×30 / Middle 80×60 / Large 120×90)" 
                        Minimum="1" Maximum="3" TickFrequency="1" SmallChange="1" LargeChange="1" Value="2"
                        TickPlacement="BottomRight"/>
                </StackPanel>
            </GroupBox>
            <!--TODO：マウスホイールで拡大/縮小したい-->
            <GroupBox Header="拡大/縮小" DockPanel.Dock="Left" >
                <StackPanel Style="{StaticResource StackPanelInGroupBoxTemplate}" >
                    <TextBlock Text="{Binding ElementName=SliderScale, Path=Value, StringFormat={}{0:0.0} 倍:}" Style="{StaticResource TextBlockTemplate}" />
                    <Slider Name="SliderScale" ToolTip="下に表示中の画像の倍率。0.1〜5.0倍を0.1刻みで指定する"
                        Minimum="0.1" Maximum="5.0" TickFrequency="0.1" SmallChange="0.1" LargeChange="1.0" Value="1.0"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="回転" DockPanel.Dock="Left" >
                <StackPanel Style="{StaticResource StackPanelInGroupBoxTemplate}" >
                    <!--Labelだと、StringFormatでうまく文字が表示できない
                    <Label Content="{Binding ElementName=SliderAngle, Path=Value, StringFormat={0:0000}}" />-->
                    <TextBlock Text="{Binding ElementName=SliderAngle, Path=Value, StringFormat={}{0:000} 度:}" Style="{StaticResource TextBlockTemplate}" />
                    <Slider Name="SliderAngle" ToolTip="下に表示中の画像の回転角。0〜360度を1度刻みで時計回りに回す"
                        Minimum="0" Maximum="360" TickFrequency="1" SmallChange="1" LargeChange="90" Value="0"/>
                </StackPanel>
            </GroupBox>

            <!--TODO：ウィンドウ右端に吸着しない-->
            <GroupBox Header="ファイル" Width="450" DockPanel.Dock="Right">
                <StackPanel Orientation="Vertical" Style="{StaticResource StackPanelInGroupBoxTemplate}" >
                    <!--テキストボックスの値を変更されるとサムネイルが不正動作するのでReadOnlyにする-->
                    <TextBox Name="TextDirName" ToolTip="サムネイル表示中のフォルダ(読み取り専用)。左の「開く」で変更する" IsReadOnly="True"/>
                    <TextBox Name="TextFileName" ToolTip="サムネイル一覧で選択中のファイル名(読み取り専用)" Text="{Binding ElementName=ListBoxThumbnail, Path=SelectedItem.FileName}" IsReadOnly="True"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <ListBox x:Name="ListBoxThumbnail" DockPanel.Dock="Top" ItemsSource="{Binding}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <!--サムネイルを横に並べる-->
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>

                    <!--Memo：WrapPanelのOrientationがVerticalの場合、StackPanelのOrientationをHorizontalにしないと、ファイル名が表示されない-->
                    <StackPanel>
                        <Image Stretch="Fill"
                               Source="{Binding FileFullpath, Converter={StaticResource ImageConverter}}"
                               Width="{Binding ElementName=SliderThumbnail, Path=Value, Converter={StaticResource ThumbnailSizeWidthConverter}}"
                               Height="{Binding ElementName=SliderThumbnail, Path=Value, Converter={StaticResource ThumbnailSizeHeightConverter}}"/>
                        <TextBlock Text="{Binding FileName}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--<StackPanel Orientation="Vertical">を設定していると、スクロールバーが常にDisableになる-->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <!--「Stretch="None"」にしないとScalingが効かない-->
            <Image Name="ImageView" Stretch="None" Source="{Binding ElementName=ListBoxThumbnail, Path=SelectedItem.FileFullpath}" >
                <Image.LayoutTransform>
                    <TransformGroup>
                        <RotateTransform Angle="{Binding ElementName=SliderAngle, Path=Value}"/>
                        <ScaleTransform ScaleX="{Binding ElementName=SliderScale, Path=Value}" ScaleY="{Binding ElementName=SliderScale, Path=Value}"/>
                    </TransformGroup>
                </Image.LayoutTransform>
            </Image>
        </ScrollViewer>
    </DockPanel>
</Window>
