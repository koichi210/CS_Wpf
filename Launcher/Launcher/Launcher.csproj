<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <RootNamespace>Launcher</RootNamespace>
    <AssemblyName>Launcher</AssemblyName>
    <ApplicationIcon />
  </PropertyGroup>

  <ItemGroup>
    <!-- 保存先フォルダの管理（ポインタファイル方式）とフォルダ選択ダイアログはCheetos/FFEdit/FileArranger等と共通のロジックを使う -->
    <Compile Include="..\..\_Common\UserDataLocation.cs" Link="Common\UserDataLocation.cs" />
    <Compile Include="..\..\_Common\DataFolderChooser.cs" Link="Common\DataFolderChooser.cs" />
    <!-- 入力欄が空の時に入力例を薄く表示する添付プロパティ(Placeholder.Text) -->
    <Compile Include="..\..\_Common\Wpf\WpfPlaceholder.cs" Link="Common\WpfPlaceholder.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- net10.0-windows(SDK形式)から.NET Framework向けの古いWindowsAPICodePack(Shellが依存するCoreを含む)を参照するため
         NU1701(ターゲットフレームワーク不一致)が出る。_Common/DataFolderChooser.cs経由で
         CS_Form/CS_Wpfの他プロジェクトと共有している依存で、.NET Frameworkの互換シムで
         問題なく動作するため抑止する。 -->
    <PackageReference Include="WindowsAPICodePack-Shell" Version="1.1.1" NoWarn="NU1701" />
  </ItemGroup>

  <PropertyGroup>
    <!-- 依存先WindowsAPICodePack-Core分はPackageReference個別指定のNoWarnが効かないため、
         プロジェクト全体でも抑止する。 -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

</Project>
