<Window x:Class="Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ランチャー" Height="650" Width="480"
        MinHeight="300" MinWidth="360">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 上部ツールバー -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="AddSectionButton" Content="＋ セクション追加" Padding="8,4" Margin="0,0,6,0" Click="AddSectionButton_Click"/>
            <Button x:Name="ReloadButton" Content="再読み込み" Padding="8,4" Margin="0,0,6,0" Click="ReloadButton_Click"
                    ToolTip="設定ファイル(config.json)を読み直して画面に反映する。他の方法で手動編集した内容を取り込みたい時に使う"/>
            <Button x:Name="OpenConfigButton" Content="設定ファイルを開く" Padding="8,4" Margin="0,0,6,0" Click="OpenConfigButton_Click"
                    ToolTip="今の内容を保存してから、設定ファイル(config.json)を関連付けられたエディタ(メモ帳等)で開く。直接編集したい時用"/>
            <Button x:Name="ChangeDataFolderButton" Content="保存先フォルダを変更..." Padding="8,4" Click="ChangeDataFolderButton_Click"
                    ToolTip="設定ファイルの保存先フォルダを選び直す。選んだ先に既存のconfig.jsonが無ければ今のファイルを移動し、次回以降もそのフォルダを使う"/>
        </StackPanel>

        <!-- 現在の保存先フォルダ表示 -->
        <TextBlock x:Name="DataFolderText" Grid.Row="1" Margin="0,0,0,8" Foreground="#777777" TextTrimming="CharacterEllipsis"/>

        <!-- セクション一覧 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SectionsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,8" BorderBrush="#CCCCCC" BorderThickness="1" Padding="4">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="＋項目" Padding="6,2" Margin="4,0" Click="AddItemButton_Click" Tag="{Binding}"/>
                                    <Button Grid.Column="2" Content="名前変更" Padding="6,2" Margin="4,0" Click="RenameSectionButton_Click" Tag="{Binding}"/>
                                    <Button Grid.Column="3" Content="削除" Padding="6,2" Margin="4,0" Click="DeleteSectionButton_Click" Tag="{Binding}"/>
                                </Grid>
                            </Expander.Header>

                            <ItemsControl ItemsSource="{Binding Items}" Margin="12,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="{Binding Title}" HorizontalContentAlignment="Left" Padding="8,4" Click="LaunchItemButton_Click" Tag="{Binding}"
                                                    ToolTip="{Binding Path}"/>
                                            <Button Grid.Column="1" Content="編集" Padding="6,2" Margin="4,0" Click="EditItemButton_Click" Tag="{Binding}"/>
                                            <Button Grid.Column="2" Content="削除" Padding="6,2" Margin="4,0" Click="DeleteItemButton_Click" Tag="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
