<Window x:Class="CheetosForWpf.RotationPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stc="clr-namespace:StandardTemplate.Wpf"
        Title="RotationPreview" Icon="Cheetos.ico"
        Width="650" Height="688" MinWidth="550" MinHeight="200"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12,8,3,3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="ファイルパス" Padding="2,0" Margin="0,0,4,0" VerticalAlignment="Center" />
            <stc:TextBoxEx Grid.Column="1" x:Name="textBox_LoadFilePath" FolderPathOnly="False" VerticalAlignment="Center" />
            <Button Grid.Column="2" x:Name="button_draw" Content="load" Width="75" Height="23" Margin="6,0,0,0" Click="button_ClickDraw" />
            <Button Grid.Column="4" x:Name="buttonOk" Content="OK" Width="75" Height="23" Click="buttonOk_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="1" Content="原点X" Padding="2,0" Margin="0,0,4,0" VerticalAlignment="Center" />
            <stc:TextBoxEx Grid.Column="2" x:Name="textBox_OriginX" Text="0" VerticalAlignment="Center"
                           PreviewKeyDown="textBox_OriginX_KeyDown" TextChanged="textBox_Param_TextChanged" />
            <Label Grid.Column="3" Content="原点Y" Padding="2,0" Margin="6,0,4,0" VerticalAlignment="Center" />
            <stc:TextBoxEx Grid.Column="4" x:Name="textBox_OriginY" Text="0" VerticalAlignment="Center"
                           PreviewKeyDown="textBox_OriginY_KeyDown" TextChanged="textBox_Param_TextChanged" />
            <Label Grid.Column="5" Content="角度" Padding="2,0" Margin="6,0,4,0" VerticalAlignment="Center" />
            <stc:TextBoxEx Grid.Column="6" x:Name="textBox_angle" Text="0" VerticalAlignment="Center"
                           PreviewKeyDown="textBox_Angle_KeyDown" TextChanged="textBox_Param_TextChanged" />
            <Button Grid.Column="8" x:Name="buttonCancel" Content="Cancel" Width="75" Height="23" Click="buttonCancel_Click" />
        </Grid>

        <!-- WinForms版のPictureBox(SizeMode=AutoSize)と同じく、画像は等倍で左上から表示し、はみ出した分は切れる -->
        <Grid Grid.Row="2" Margin="3,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="302" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" ClipToBounds="True">
                <Image x:Name="pictureBox_Source" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Border>
            <Border Grid.Column="1" ClipToBounds="True">
                <Image x:Name="pictureBox_Dest" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Border>
        </Grid>
    </Grid>
</Window>
