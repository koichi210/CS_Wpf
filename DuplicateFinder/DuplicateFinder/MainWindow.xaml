<Window x:Class="DuplicateFinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重複ファイル削除ツール" Height="720" Width="1150"
        Language="ja-JP" AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop" Closing="Window_Closing">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right">
                <ProgressBar x:Name="WorkProgressBar" Width="240" Height="14" Maximum="1000" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis"
                           Text="対象フォルダを追加(ドラッグ＆ドロップも可・複数可)して「検索開始」を押してください。" />
            </StatusBarItem>
        </StatusBar>

        <Grid DockPanel.Dock="Top" Margin="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="対象フォルダ" VerticalAlignment="Top" Margin="0,3,6,0" />
            <ListBox x:Name="FolderList" Grid.Row="0" Grid.Column="1" Height="96" SelectionMode="Extended"
                     KeyDown="FolderList_KeyDown"
                     ToolTip="ここに登録したどのフォルダ(サブフォルダ含む)にあるファイル同士でも比べます。フォルダのドラッグ＆ドロップでも追加できます" />
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="6,0,0,0">
                <Button x:Name="AddFolderButton" Content="追加(_B)..." Padding="10,2" Click="AddFolderButton_Click" />
                <Button x:Name="RemoveFolderButton" Content="外す" Padding="10,2" Margin="0,3,0,0" Click="RemoveFolderButton_Click"
                        ToolTip="選んだフォルダをリストから外します(フォルダ自体は消しません)" />
                <Button x:Name="MoveUpButton" Content="▲ 上へ" Padding="10,2" Margin="0,3,0,0" Click="MoveUpButton_Click"
                        ToolTip="自動選択の「リストの上の対象フォルダにあるものを残す」で優先されます" />
                <Button x:Name="MoveDownButton" Content="▼ 下へ" Padding="10,2" Margin="0,3,0,0" Click="MoveDownButton_Click" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="3" Margin="12,0,0,0">
                <Button x:Name="ScanButton" Content="検索開始(_S)" Padding="14,3" FontWeight="Bold" Click="ScanButton_Click" />
                <Button x:Name="CancelButton" Content="中止" Padding="10,3" Margin="0,6,0,0" IsEnabled="False" Click="CancelButton_Click"
                        ToolTip="検索を止めます。それまでに比較し終えて重複と確定した分は一覧に表示します" />
            </StackPanel>

            <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,6,0,0">
                <CheckBox x:Name="CrossRootCheck" Content="別々の対象フォルダにまたがる重複だけ" VerticalAlignment="Center" Margin="0,0,16,0"
                          ToolTip="同じ対象フォルダの中だけでの重複は無視します(比べる量が減るので速くなります)" />
                <TextBlock Text="最小サイズ" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="MinSizeBox" Width="56" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                         ToolTip="これより小さいファイルは対象外にします(0バイトのファイルは常に対象外)。小数も可(例: 0.5)" />
                <TextBlock Text="MB" VerticalAlignment="Center" Margin="4,0,16,0" />
                <TextBlock Text="拡張子" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="ExtensionsBox" Width="180" VerticalContentAlignment="Center"
                         ToolTip="対象にする拡張子を ; 区切りで(例: mp4;mkv;avi)。空欄ならすべてのファイル" />
                <TextBlock Text="(空欄＝すべて)" Foreground="Gray" VerticalAlignment="Center" Margin="4,0,16,0" />
                <CheckBox x:Name="SkipHiddenCheck" Content="隠し・システムファイルを除外" VerticalAlignment="Center" Margin="0,0,16,0"
                          ToolTip="desktop.ini や Thumbs.db などが大量に重複扱いになるのを防ぎます" />
                <TextBlock Text="同時比較数" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="ParallelCombo" Width="52"
                          ToolTip="同時に比較するグループ数。HDD・外付けHDD・NASは1が最速、SSDなら4〜8以上で速くなります(多いほどメモリを使いますが、合計1GBまでに抑えます)" />
            </WrapPanel>
        </Grid>

        <DockPanel DockPanel.Dock="Top" Margin="8,10,8,6" LastChildFill="False">
            <TextBlock Text="自動選択" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="KeepRuleCombo" Width="270" DisplayMemberPath="Value" SelectedValuePath="Key" />
            <Button x:Name="ApplyRuleButton" Content="適用(_A)" Padding="10,3" Margin="6,0,0,0" Click="ApplyRuleButton_Click"
                    ToolTip="各グループで1件だけ残し、残りすべてに削除チェックを付けます" />
            <Button x:Name="ClearMarksButton" Content="チェックをすべて外す" Padding="10,3" Margin="6,0,0,0" Click="ClearMarksButton_Click" />
            <TextBlock x:Name="MarkedSummaryText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#A00000" />

            <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="チェックしたファイルを削除(_D)" Padding="12,3" Click="DeleteButton_Click" />
            <CheckBox x:Name="RecycleCheck" DockPanel.Dock="Right" Content="ごみ箱へ移動" VerticalAlignment="Center" Margin="0,0,10,0"
                      ToolTip="外すと完全に削除します(元に戻せません)" />
        </DockPanel>

        <DataGrid x:Name="ResultGrid" Margin="8,0,8,8"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Extended"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8E8E8"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  PreviewKeyDown="ResultGrid_PreviewKeyDown" MouseDoubleClick="ResultGrid_MouseDoubleClick">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="2,8,0,2" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMarked}" Value="True">
                            <Setter Property="Background" Value="#FFE4E4" />
                            <Setter Property="Foreground" Value="#A00000" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="削除" Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsMarked, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="対象" Binding="{Binding RootNumber}" Width="40">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="280" />
                <DataGridTextColumn Header="サイズ" Binding="{Binding SizeText}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="更新日時" Binding="{Binding LastWriteTime, StringFormat=yyyy/MM/dd HH:mm:ss}" Width="140" />
                <DataGridTextColumn Header="フォルダ" Binding="{Binding Folder}" Width="*" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="このファイルを残す(同じグループの他を削除対象に)" Click="KeepThisMenu_Click" />
                    <MenuItem Header="このフォルダ以下のファイルを全グループで残す" Click="KeepFolderMenu_Click" />
                    <MenuItem Header="削除チェックを切り替え" InputGestureText="Space" Click="ToggleMarkMenu_Click" />
                    <Separator />
                    <MenuItem Header="開く" InputGestureText="ダブルクリック" Click="OpenMenu_Click" />
                    <MenuItem Header="エクスプローラーで表示" Click="ShowInExplorerMenu_Click" />
                    <MenuItem Header="パスをコピー" Click="CopyPathMenu_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </DockPanel>
</Window>
