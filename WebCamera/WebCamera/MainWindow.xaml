<Window x:Class="WebCamera.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WebCamera"
        Width="680" Height="591"
        MinWidth="320" MinHeight="280"
        Closing="Window_Closing"
        Closed="Window_Closed">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Black">
            <Image x:Name="image_Preview"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="button_StartStop"
                    Content="Start"
                    Width="104" Height="36"
                    TabIndex="1"
                    ToolTip="PCの1台目のカメラの映像表示を開始/停止する"
                    ToolTipService.ShowDuration="15000"
                    Click="button_StartStop_Click" />
            <Button x:Name="button_Snapshot"
                    Content="Snapshot"
                    Width="104" Height="36"
                    Margin="6,0,0,0"
                    TabIndex="2"
                    IsEnabled="False"
                    ToolTip="押した瞬間に表示中の映像をPNGで保存する。停止後も最後に表示した映像を保存できる"
                    ToolTipService.ShowDuration="15000"
                    ToolTipService.ShowOnDisabled="True"
                    Click="button_Snapshot_Click" />
        </StackPanel>
    </Grid>
</Window>
