<Window x:Class="TrimFileData.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stc="clr-namespace:StandardTemplate.Wpf"
        Title="TrimFileData" Icon="TrimFileData.ico"
        Width="500" Height="490" MinWidth="350" MinHeight="300">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- リファレンスファイルパス -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="リファレンスファイルパス" Padding="0,0,6,0" VerticalAlignment="Center" />
            <stc:TextBoxEx Grid.Column="1" x:Name="textBox_ReferencePath" FolderPathOnly="False" VerticalAlignment="Center"
                           stc:Placeholder.Text="例: C:\Work\reference.txt"
                           ToolTip="検索対象のテキストファイル(Shift_JISとして読み込む)。Enterキーで関連付けられたアプリで開く"
                           ToolTipService.ShowDuration="15000"
                           KeyDown="textBox_ReferencePath_KeyDown" />
        </Grid>

        <!-- 設定 -->
        <GroupBox Grid.Row="1" Header="設定" Padding="4" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="共通ワード" Padding="0,0,0,2" VerticalAlignment="Bottom" />
                <stc:TextBoxEx Grid.Row="1" Grid.Column="0" x:Name="textBox_SearchCommonWord" VerticalAlignment="Center" Margin="0,0,12,0"
                               stc:Placeholder.Text="例: error"
                               ToolTip="指定するとこの文字列を含む行だけを検索対象にする。空欄なら全行が対象"
                               ToolTipService.ShowDuration="15000" />
                <CheckBox Grid.Row="0" Grid.Column="1" x:Name="checkBox_FirstWordOnly" Content="最初にヒットしたワードだけを抽出" Margin="0,0,0,4"
                          ToolTip="各ワードについて、最初に見つかった1行だけを抽出する"
                          ToolTipService.ShowDuration="15000" />
                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="checkBox_OrdinalCase" Content="大文字小文字を区別する" VerticalAlignment="Center" />
            </Grid>
        </GroupBox>

        <!-- 検索ワード / 検索結果 -->
        <Grid Grid.Row="2" Grid.RowSpan="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Grid.Column="0" Content="検索ワード" Padding="0,0,0,2" />
            <stc:TextBoxEx Grid.Row="1" Grid.Column="0" x:Name="textBox_SearchWordList"
                           AcceptsReturn="True" TextWrapping="NoWrap"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                           ToolTip="1行が1グループ。行内をスペースで区切った各ワードを含む行を抽出し、行ごとに「◆」見出しを付けて出力する"
                           ToolTipService.ShowDuration="15000" />
            <Label Grid.Row="0" Grid.Column="1" Content="検索結果" Padding="0,0,0,2" Margin="23,0,0,0" />
            <stc:TextBoxEx Grid.Row="1" Grid.Column="1" x:Name="textBox_SearchResultList" Margin="23,0,0,0"
                           AcceptsReturn="True" TextWrapping="NoWrap"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Grid>

        <Button Grid.Row="4" x:Name="button_Execute" Content="実行" Width="75" Height="23" Margin="0,6,0,0" HorizontalAlignment="Right"
                ToolTip="検索結果を検索結果欄に出し、クリップボードにもコピーする"
                ToolTipService.ShowDuration="15000"
                Click="button_Execute_Click" />

        <!-- 設定の読み込み/保存 -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="comboBox_LoadSetting" Margin="0,0,6,0" VerticalAlignment="Center"
                      ToolTip="選ぶと保存済みの設定を読み込み、各欄の内容が置き換わる"
                      ToolTipService.ShowDuration="15000"
                      SelectionChanged="comboBox_LoadSetting_SelectionChanged" />
            <Button Grid.Column="1" x:Name="button_SaveSetting" Content="設定保存" Width="75" Height="23" Click="button_SaveSetting_Click" />
        </Grid>
    </Grid>
</Window>
