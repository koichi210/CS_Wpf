<Window x:Class="FFEditForWpf.ErrorMsg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:stc="clr-namespace:StandardTemplate.Wpf"
        Title="ErrorMsg" Width="535" Height="335" MinWidth="200" MinHeight="200"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12,6,12,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Content="いくつかの処理が失敗しました。" Padding="0,0,0,3" />
        <stc:TextBoxEx Grid.Row="1" x:Name="textBox_ErrorMessage" IsReadOnly="True"
                       AcceptsReturn="True" TextWrapping="NoWrap"
                       VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" />
        <Button Grid.Row="2" x:Name="button_Close" Content="OK" Width="75" Height="23" Margin="0,6,0,0"
                HorizontalAlignment="Right" IsDefault="True" Click="button_Close_Click" />
    </Grid>
</Window>
